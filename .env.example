# SplitSaathi Configuration Template
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO GIT.
# Configure sensitive values locally or via the Secrets panel.

# SUPABASE CLIENT CONFIGURATION (Public credentials only)
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=[YOUR-ANON-PUBLIC-KEY]

# DATABASE CONNECTION (Server/CLI migration only - NEVER embed in client APK)
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# SUPABASE_TEST_DB_URL=postgresql://postgres:[PASSWORD]@[TEST-HOST]:5432/postgres

# GEMINI_API_KEY: Optional Gemini API key managed via AI Studio secrets
# GEMINI_API_KEY=MY_GEMINI_API_KEY
